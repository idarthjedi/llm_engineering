    "def make_file(start, end, filename):\n",
    "    batch_file = filename\n",
    "    with open(batch_file, \"w\") as f:\n",
    "        for i in range(start, end):\n",
    "            f.write(make_jsonl(items[i]))\n",
    "            f.write(\"\\n\")"
